# ── Nankara Shop API — environment ──
# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# PostgreSQL (SQLAlchemy + psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://nankara:nankara@localhost:5433/nankara

# JWT signing secret for admin sessions — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed browser origins (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# Cloudinary — product image storage/CDN
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=nankara/products

# ── Reserved for later milestones (not used yet) ──
# NGN_PER_USD=1600
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
