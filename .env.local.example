# Copy to .env.local for local development:  cp .env.local.example .env.local
# (.env.local is git-ignored; this example file is committed.)

# Origin of the FastAPI backend (see backend/). Used by next.config.mjs to proxy
# /api/v1/* and by server components to fetch product data directly.
BACKEND_ORIGIN=http://localhost:8000

# Approximate NGN per 1 USD, used only for the display-only "Approx. $X USD" line
# shown to international visitors. Not money-authoritative — the real rate moves to
# the backend in Milestone 3 (Paystack). Must be prefixed NEXT_PUBLIC_ to be
# readable in the browser.
NEXT_PUBLIC_NGN_PER_USD=1600
